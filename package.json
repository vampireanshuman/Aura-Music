{
  "name": "aura-music",
  "private": true,
  "version": "1.1.0",
  "description": "Ultra-modern, glassmorphic music streaming web player inspired by Apple Music & Spotify with dynamic atmospheric lighting, time-synced lyrics, and studio-grade Web Audio DSP.",
  "type": "module",
  "license": "GPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "https://github.com/vampireanshuman/Aura-Music.git"
  },
  "keywords": [
    "music-player",
    "react-19",
    "vite",
    "tailwindcss-v4",
    "glassmorphism",
    "audio-visualizer",
    "apple-music",
    "spotify",
    "synced-lyrics",
    "webaudio-api",
    "android-apk",
    "capacitor"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "cap:build": "npm run build && npx cap sync android",
    "cap:sync": "npx cap sync android",
    "cap:open": "npx cap open android",
    "build:apk": "npm run cap:build && cd android && ./gradlew assembleRelease"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/core": "^8.6.0",
    "@distube/ytdl-core": "^5.2.1",
    "@types/crypto-js": "^4.2.2",
    "canvas-confetti": "^1.9.4",
    "crypto-js": "^4.2.0",
    "lucide-react": "^1.70.0",
    "mqtt": "^5.16.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0",
    "@tailwindcss/vite": "^4.3.5",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.90.0",
    "tailwindcss": "^4.3.5",
    "typescript": "~7.0.2",
    "vite": "^8.3.6"
  }
}
