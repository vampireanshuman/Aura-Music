# ==============================================================================
# Aura Music — Environment Configuration Template
# Copy this file to '.env' or '.env.local' to configure your environment.
# Never commit your actual '.env' file or production secrets to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Dev Server Network Configuration
# ------------------------------------------------------------------------------
# Host interface to bind the Vite dev server (0.0.0.0 listens on all interfaces)
VITE_DEV_HOST=0.0.0.0
# Port for local development
VITE_DEV_PORT=5173

# ------------------------------------------------------------------------------
# 2. API Endpoints & Proxies
# ------------------------------------------------------------------------------
# Base URL for custom audio/streaming backend proxy.
# Leave blank to use the built-in Vite streaming middleware and same-origin /api/*
VITE_API_BASE_URL=

# Public LRCLIB API endpoint for time-synchronized karaoke lyrics
# Default public instance: https://lrclib.net/api
VITE_LRCLIB_API_URL=https://lrclib.net/api

# ------------------------------------------------------------------------------
# 3. Third-Party Integrations (Optional)
# ------------------------------------------------------------------------------
# Optional YouTube Data API v3 key (for extended catalog searching & quotas)
VITE_YOUTUBE_API_KEY=

# Optional Spotify Developer App Credentials (for high-volume playlist extraction)
VITE_SPOTIFY_CLIENT_ID=
VITE_SPOTIFY_CLIENT_SECRET=

# ------------------------------------------------------------------------------
# 4. Engine & Audio DSP Features
# ------------------------------------------------------------------------------
# Enables hardware-accelerated Web Audio API filters (Equalizer, AutoEq, Spatializer)
VITE_ENABLE_AUDIO_DSP=true

# Enables native hardware-accelerated video decoding (H.264/AVC1)
VITE_ENABLE_HARDWARE_ACCELERATION=true
